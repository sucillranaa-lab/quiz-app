{
  "name": "quiz-app",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "generate-quiz-index": "node scripts/generate-quiz-index.js",
    "prestart": "npm run generate-quiz-index",
    "prebuild:web": "npm run generate-quiz-index",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "npm run generate-quiz-index && expo start --web",
    "build:web": "npm run generate-quiz-index && npx expo export --platform web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "expo": "~52.0.0",
    "expo-status-bar": "~2.0.0",
    "idb": "^8.0.0",
    "lucide-react-native": "^0.460.0",
    "nativewind": "^4.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "^0.76.9",
    "react-native-safe-area-context": "^4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "metro": "^0.81.0",
    "metro-cache": "^0.81.0",
    "metro-config": "^0.81.0",
    "metro-resolver": "^0.81.0"
  }
}
